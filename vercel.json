{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/editor",
      "destination": "/api/editor"
    },
    {
      "source": "/editor/",
      "destination": "/api/editor"
    },
    {
      "source": "/login",
      "destination": "/api/login"
    },
    {
      "source": "/login/",
      "destination": "/api/login"
    },
    {
      "source": "/api/preview/run/:grant/",
      "destination": "/api/preview?grant=:grant"
    },
    {
      "source": "/api/preview/run/:grant/:file*",
      "destination": "/api/preview?grant=:grant&file=:file*"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/((?!api(?:/|$)|editor(?:/|$)|login(?:/|$)|demos(?:/|$)|assets/figures(?:/|$)).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; script-src 'self' 'sha256-WZRJfWvsnNCPcxzZwvyhovnZGqhZaC+8gPGPRbx6wTk=' 'sha256-eQFTCRW0GRMmGZfk2WFOvO7QyNryti0GVsZuYnibils='; connect-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; frame-src 'self'; worker-src 'self'"
        }
      ]
    },
    {
      "source": "/styles/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles/katex.min.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/demos/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox allow-scripts"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/figures/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox allow-scripts"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
