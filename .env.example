# Copy to .env and fill in. .env is gitignored; never commit real values.
# Load with: node --env-file=.env <script>

# --- Cloudflare R2: the only data store (CLAUDE.md §1.1, §3.2) ---------------
R2_ACCOUNT_ID=
R2_BUCKET=weblog-data

# Either the R2_* names or the standard AWS_* names work; R2_* wins if both are
# set. The build needs a READ-ONLY credential; the editor functions need
# read/write.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Environment namespace inside the bucket. Organizational only — a
# bucket-scoped credential still reaches every prefix, so this is not an
# authorization boundary (§3.3).
R2_PREFIX=dev

# --- Site --------------------------------------------------------------------
SITE_URL=https://blog.souravmishra.net

# --- Publishing (Step 6) -----------------------------------------------------
# Treat as a secret: anyone holding it can trigger production builds.
VERCEL_DEPLOY_HOOK_URL=
PUBLISH_ENABLED=false

# --- Editor auth (Step 3) ----------------------------------------------------
ADMIN_PASSWORD_HASH=
AUTH_VERSION=1
RATE_LIMIT_HASH_SECRET=

# --- Deployment status (Step 7) ----------------------------------------------
VERCEL_API_TOKEN=
VERCEL_WEBHOOK_SECRET=
BLOG_VERCEL_PROJECT_ID=
